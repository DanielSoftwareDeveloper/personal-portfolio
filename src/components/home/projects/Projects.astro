---
import { Image } from "astro:assets";
import { projectList } from "./project-list";
import Title from "@/components/shared/ui/Title.astro";
import Container from "@/components/shared/ui/Container.astro";
---

<section id="projects" class="my-20">
  <Container>
    <Title title="Portafolio" />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projectList.map((project) => (
          <div class="card rounded-xl p-4 border border-neutral-200 dark:border-neutral-800">
            <a href={project.href} target="_blank">
              <Image
                src={project.image}
                alt={project.name}
                width={800}
                height={600}
                class="w-full h-60 object-cover rounded-lg mb-4"
              />
            </a>

            <h3 class="text-xl text-center font-bold mb-1">{project.name}</h3>

            <p class="text-center text-sm mb-4">{project.description}</p>

            <div class="grid grid-cols-2 gap-3">
              <a href={project.href} target="_blank" class="button">
                View Project
              </a>

              {project.github && (
                <a href={project.github} target="_blank" class="button">
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
