---
import { Image } from "astro:assets";
import { projectList } from "./project-list";
import Title from "@/components/shared/ui/Title.astro";
import Container from "@/components/shared/ui/Container.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="projects" class="my-20">
  <Container>
    <Title title={t("projects.title")} />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projectList.map((project) => (
          <div class="card rounded-xl p-4 border border-neutral-200 dark:border-neutral-800">
            <a href={project.href} target="_blank">
              <Image
                src={project.image}
                alt={project.name}
                width={800}
                height={600}
                class="w-full h-60 object-cover rounded-lg mb-4"
              />
            </a>

            <h3 class="text-xl text-center font-bold mb-1">{project.name}</h3>

            <p class="text-center text-sm mb-4">{t(project.descriptionKey)}</p>

            <div class="flex gap-3">
              <a href={project.href} target="_blank" class="button flex-1">
                {t("projects.viewProject")}
              </a>

              {project.github && (
                <a href={project.github} target="_blank" class="button flex-1">
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
