---
import { Icon } from "astro-icon/components";
import { skillList } from "./skill-list";
import Title from "@/components/shared/ui/Title.astro";
import Container from "@/components/shared/ui/Container.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="skills" class="bg-section">
  <Container>
    <Title title={t("skills.title")} />
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-8">
      {
        skillList.map((service) => (
          <div class="flex flex-col items-center justify-center text-center">
            <Icon
              name={service.icon}
              size={35}
              class={`mb-2 ${service.color}`}
            />
            <h3 class="text-lg font-semibold mb-3">{t(service.nameKey)}</h3>
            <p class="text-sm">{t(service.descriptionKey)}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
