---
import { Icon } from "astro-icon/components";
import { skillList } from "./skill-list";
import Title from "@/components/shared/ui/Title.astro";
import Container from "@/components/shared/ui/Container.astro";
---

<section id="skills" class="bg-section">
  <Container>
    <Title title="Skills" />
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-8">
      {
        skillList.map((service) => (
          <div class="flex flex-col items-center justify-center text-center">
            <Icon name={service.icon} size={35} class="mb-2 text-yellow-300" />
            <h3 class="text-lg font-semibold mb-3">{service.name}</h3>
            <p class="text-sm">{service.description}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
