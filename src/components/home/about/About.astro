---
import { Icon } from "astro-icon/components";
import { contactList } from "./contact-list";
import Container from "@/components/shared/ui/Container.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="about" class="my-34">
  <Container className="flex flex-col items-center">
    <div class="md:w-4xl flex flex-col items-center text-center">
      <h1 class="text-2xl md:text-3xl font-bold mb-1">Daniel Reyes</h1>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-index">
        {t("about.role")}
      </h2>
      <p class="text-sm md:text-base text-pretty mt-4 mb-3 md:my-6">
        <span class="font-semibold text-index">{t("about.intro")}</span>,{" "}
        {t("about.description")}
      </p>
      <div class="flex items-center justify-center md:justify-start space-x-8">
        <div class="flex">
          <a href="/Daniel%20Reyes%20CV.pdf" download="Daniel Reyes CV.pdf">
            <button class="button">{t("about.downloadCV")}</button>
          </a>
        </div>
        <div class="flex items-center space-x-3">
          {
            contactList.map((item) => (
              <a
                href={item.href}
                target="_blank"
                class={`bg-[#303030] border border-neutral-700 p-2.5 rounded-full ${item.color} transition-colors ease-in-out`}
              >
                <Icon name={item.icon} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
