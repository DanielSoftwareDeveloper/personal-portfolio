---
import { Icon } from "astro-icon/components";
import { contactList } from "./contact-list";
import Container from "@/components/shared/ui/Container.astro";
---

<section id="about" class="my-34">
  <Container className="flex flex-col items-center">
    <div class="md:w-4xl flex flex-col items-center text-center">
      <h1 class="text-2xl md:text-3xl font-bold mb-1">Daniel Reyes</h1>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-index">
        Software Developer
      </h2>
      <p class="text-sm md:text-base text-pretty mt-4 mb-3 md:my-6">
        <span class="font-semibold text-index">Desarrollador Full Stack</span>,
        me enfoco en la creación de aplicaciones web modernas y escalables,
        tengo experiencia desarrollando interfaces de usuario, servicios
        backend, sistemas de autenticación e integraciones con inteligencia
        artificial, he desarrollado aplicaciones completas desde la idea hasta
        su despliegue enfocandome en escribir código limpio, mantenible y en
        construir productos con buena experiencia de usuario y arquitectura
        sólida.
      </p>
      <div class="flex items-center justify-center md:justify-start space-x-8">
        <div class="flex">
          <a
            href="/Daniel%20Reyes%20CV%20(en).pdf"
            download="Daniel Reyes CV (en).pdf"
          >
            <button class="button">Download CV</button>
          </a>
        </div>
        <div class="flex items-center space-x-3">
          {
            contactList.map((item) => (
              <a
                href={item.href}
                target="_blank"
                class={`bg-[#303030] border border-neutral-700 p-2.5 rounded-full ${item.color} transition-colors ease-in-out`}
              >
                <Icon name={item.icon} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
