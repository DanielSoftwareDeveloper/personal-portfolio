---
import { Icon } from "astro-icon/components";
import Container from "../ui/Container.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<footer class="bg-neutral-800/80 backdrop-blur-md pt-14 pb-16">
  <Container className="flex flex-col items-center">
    <div class=""></div>
    <div class="">
      <p class="text-sm dark:text-neutral-300 font-semibold flex items-center">
        {t("footer.madeWith")} <Icon name="general/heart" class="mx-1" size={22} />
        {t("footer.credits")}
      </p>
    </div>
  </Container>
</footer>
