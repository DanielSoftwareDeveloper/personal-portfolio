---
import NavbarRoute from "./NavbarRoute.astro";

interface Props {
  routes: { label: string; path: string }[];
}
const { routes } = Astro.props;
---

<ul class="hidden md:flex gap-x-6 md:gap-x-8">
  {
    routes.map((route) => (
      <li>
        <NavbarRoute name={route.label} href={route.path} />
      </li>
    ))
  }
</ul>